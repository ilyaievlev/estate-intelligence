        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-ds"
          },
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT multiIf(monthly_rent < 45000, '1. Эконом (до 45k ₽)', monthly_rent < 75000, '2. Комфорт (45k-75k ₽)', monthly_rent < 120000, '3. Бизнес (75k-120k ₽)', monthly_rent < 200000, '4. Премиум (120k-200k ₽)', '5. Элитная (от 200k ₽)') AS category, count() AS count FROM estate.apartment_snapshots GROUP BY category ORDER BY category",
          "refId": "A"
        }
      ],
      "title": "Сегментация рынка по ценовым категориям",
      "type": "bargauge"
