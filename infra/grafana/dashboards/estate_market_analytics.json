          "rawSql": "SELECT toStartOfInterval(collected_at, INTERVAL 1 HOUR) AS time, count() AS total_snapshots, uniqExact(external_id) AS unique_listings FROM estate.apartment_snapshots GROUP BY time ORDER BY time",
