# Postgres (infra/docker/docker-compose.yml)
POSTGRES_USER=estate
POSTGRES_PASSWORD=estate
POSTGRES_DB=estate
POSTGRES_HOST_PORT=5433
# Postgres (collector)
DATABASE_URL=postgresql://estate:estate@localhost:5433/estate

# ClickHouse (infra/docker/docker-compose.yml + collector); HTTP-порт для clickhouse-connect
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=estate
CLICKHOUSE_USER=estate
CLICKHOUSE_PASSWORD=estate

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_DEFAULT_BUCKET=mlflow

# MLflow
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_S3_ENDPOINT_URL=http://localhost:9010
MLFLOW_S3_IGNORE_TLS=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Apache Airflow
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@estate.local

# ML Inference REST API
INFERENCE_PORT=8000
