# Postgres (infra/docker/docker-compose.yml)
POSTGRES_USER=estate
POSTGRES_PASSWORD=estate
POSTGRES_DB=estate
# Postgres (collector)
DATABASE_URL=postgresql://estate:estate@localhost:5432/estate

# ClickHouse (infra/docker/docker-compose.yml + collector); HTTP-порт для clickhouse-connect
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=estate
CLICKHOUSE_USER=estate
CLICKHOUSE_PASSWORD=estate
