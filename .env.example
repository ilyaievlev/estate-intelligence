# ==============================================================================
# Estate Intelligence — Единая конфигурация окружения (.env.example)
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL + PostGIS (Storage)
# ------------------------------------------------------------------------------
POSTGRES_USER=estate
POSTGRES_PASSWORD=estate
POSTGRES_DB=estate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
# Connection string для подключения к Postgres с хоста (порт 5433)
DATABASE_URL=postgresql://estate:estate@localhost:5433/estate

# ------------------------------------------------------------------------------
# 2. ClickHouse OLAP (Storage & Market Analytics)
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_PROMETHEUS_PORT=9363
CLICKHOUSE_DATABASE=estate
CLICKHOUSE_USER=estate
CLICKHOUSE_PASSWORD=estate

# ------------------------------------------------------------------------------
# 3. MinIO S3 Object Storage (Model Artifacts)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_DEFAULT_BUCKET=mlflow
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# ------------------------------------------------------------------------------
# 4. MLflow Tracking Server & Model Registry
# ------------------------------------------------------------------------------
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_S3_ENDPOINT_URL=http://localhost:9010
MLFLOW_S3_IGNORE_TLS=true
MLFLOW_EXPERIMENT_NAME=estate_rent_prediction
MLFLOW_MODEL_NAME=estate_rent_catboost
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_DISABLE_AGENT_HINT=1
# Обучаться только на объявлениях, которые парсер видел за N дней (0 — все)
TRAIN_MAX_AGE_DAYS=90

# ------------------------------------------------------------------------------
# 5. Apache Airflow (Pipeline Orchestration)
# ------------------------------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@estate.local
AIRFLOW__WEBSERVER__WORKERS=2

# ------------------------------------------------------------------------------
# 6. FastAPI ML Inference REST API
# ------------------------------------------------------------------------------
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
MOSCOW_CENTER_LAT=55.753930
MOSCOW_CENTER_LON=37.620795

# ------------------------------------------------------------------------------
# 7. Data Collector & Avito Parser (Парсер объявлений аренды)
# Поля urls, use_bypass_api, cookies_api_key, proxy_string, count
# автоматически подгружаются в config.toml парсера из основного .env
# ------------------------------------------------------------------------------
COLLECTOR_INTERVAL_SEC=0
AVITO_URLS=https://www.avito.ru/moskva/kvartiry/sdam/na_dlitelnyy_srok-ASgBAgICAkSSA8gQ8AeQUg?cd=2&context=H4sIAAAAAAAA_wEmANn_YToxOntzOjE6InkiO3M6MTY6InRCTlVOYnNSbTFNZklYdlQiO30ID_1RJgAAAA&localPriority=0
AVITO_USE_BYPASS_API=true
# ключ spfa.pro и прокси в формате login:password@host:port
AVITO_COOKIES_API_KEY=
AVITO_PROXY_STRING=
AVITO_COUNT=10

# ------------------------------------------------------------------------------
# 8. Monitoring (Prometheus & Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
